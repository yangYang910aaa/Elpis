# ===== LLM 配置（OpenAI 兼容，支持硅基流动等第三方端点）=====
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
OPENAI_TEMPERATURE=0.7

# ===== Agent 配置 =====
# 最大迭代轮数，防止无限循环
MAX_AGENT_ITERATIONS=20

# 工作目录（Agent 操作文件的根目录，留空则使用当前目录）
AGENT_WORKSPACE=

# ===== 安全配置 =====
# 执行 Shell 命令前是否需要确认 (true/false)
REQUIRE_CONFIRMATION_FOR_SHELL=true

# Shell 命令黑名单（逗号分隔，匹配到则拒绝执行）
SHELL_BLACKLIST=rm -rf /,format,mkfs,dd if=

# ===== LangSmith 追踪配置（可选）=====
# 启用后可在 https://smith.langchain.com 查看 Agent 的运行轨迹
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=elpis

# ===== MCP 配置 =====
# 麦当劳 MCP Token（https://open.mcd.cn 登录后于控制台申请，用于 elpis/mcp/servers.yaml）
MCD_MCP_TOKEN=
